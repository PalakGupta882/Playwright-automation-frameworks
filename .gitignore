# Dependencies
node_modules/

# Playwright output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Your saved login session — NEVER commit this
auth.json

# Dev-environment session for the Exchange suite. Kept under a DISTINCT name so
# a dev token can never be mistaken for the production one in auth.json, and
# vice versa. Never point a dev spec at auth.json.
auth.dev.json

# Personal Claude Code instructions
CLAUDE.local.md
# Local-only bug analysis — not published to this public repo
docs/BUG-*.csv
docs/BUG-*.html
docs/BUG-*.pdf

# Generated page-health sweep output (regenerate with npm run page-health)
/page-health.json
/page-health-report.html

# HAR captures for JMeter (tests/scripts/har-*.spec.js). The raw .har holds the
# phone number, OTP and live access/refresh tokens. Only the masked .md
# summaries next to them are safe to commit.
tests/data/har/*.har

# Test phone + fixed OTP for the HAR login journey. Copy .env.har.example.
.env.har

# Stage-environment session (tests/data/env.js names it from BASE_URL).
# Same rule as auth.dev.json: never commit, never mix with production.
auth.stage.json

# JMeter API summary from scripts/har-to-jmeter.js. Masks phone, OTP and tokens
# only; user_id, address_id and real order ids pass through unmasked.
har/
